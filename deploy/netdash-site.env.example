# /etc/netdash.env at a site without a cable modem. Owned by the service user, chmod 600.
# Never commit the real file. Never load it with `. file` in a shell: passwords containing $ get mangled.

NETDASH_SITE_NAME=Branch Office

# UniFi: a local View Only account (UniFi OS console or UniFi OS Server)
NETDASH_UNIFI_URL=https://192.0.2.10
NETDASH_UNIFI_USER=netdash-ro
NETDASH_UNIFI_PASS=
NETDASH_UNIFI_SITE=default
# The classic self-hosted Network application (https://host:8443/manage/...) instead of UniFi OS:
# NETDASH_UNIFI_KIND=classic

# The site's own look: brand.css, logo.svg or logo.png, favicon.ico (deploy with BRAND=... deploy/sync.sh push)
# NETDASH_BRAND_DIR=/opt/netdash/brand

# pfSense REST API (pfrest): read-only user's key; added by the key-creation step in NEW_SITE_GUIDE.md
# NETDASH_PFSENSE_URL=https://192.0.2.1
# NETDASH_PFSENSE_KEY=

# No modem at this site
NETDASH_MODEM_DB=none

# Logins (add users with: sudo -u netdash python3 -m netdash --db /var/lib/netdash/netdash.db user add NAME)
NETDASH_AUTH=on
NETDASH_SESSION_DAYS=30
# HTTPS, so passwords don't cross the network in clear text (paths readable by the service user)
NETDASH_TLS_CERT=/etc/netdash/cert.pem
NETDASH_TLS_KEY=/etc/netdash/key.pem

# Retention, in days
NETDASH_KEEP_DAYS=60
NETDASH_FW_KEEP_DAYS=14
NETDASH_USAGE_KEEP_DAYS=90
