# /etc/netdash.env on a box that also runs modem_check: owned by the service user, chmod 600.
# Never commit the real file. Never load it with `. file` in a shell: passwords containing $ get mangled.
# Sites without a modem: start from netdash-site.env.example instead.

NETDASH_SITE_NAME=Home network

# UniFi: a local View Only account (here, UniFi OS Server on the same box)
NETDASH_UNIFI_URL=https://127.0.0.1:12443
NETDASH_UNIFI_USER=netdash-ro
NETDASH_UNIFI_PASS=

# pfSense REST API (pfrest): the read-only user's key
NETDASH_PFSENSE_URL=https://192.168.1.1
NETDASH_PFSENSE_KEY=

# Certificate checking for the connections to pfSense and UniFi (see netdash/tlsverify.py).
# Self-signed certificates: pin them. `python3 -m netdash fingerprint` prints these lines;
# check each against the device before trusting it. Or NETDASH_*_CA=/path/to/ca.pem.
NETDASH_PFSENSE_FINGERPRINT=
NETDASH_UNIFI_FINGERPRINT=

# Logins and HTTPS: recommended even at home (anything on the LAN, or a VLAN that can
# reach it, can otherwise read the dashboard)
NETDASH_AUTH=on
NETDASH_TLS_CERT=/var/lib/netdash/tls/cert.pem
NETDASH_TLS_KEY=/var/lib/netdash/tls/key.pem

# modem_check's database (default ~/modem_check/data/modem.db of the service user) and its dashboard
# NETDASH_MODEM_DB=/home/YOUR_USER/modem_check/data/modem.db
# NETDASH_MODEM_URL=http://192.168.1.10:8520/
